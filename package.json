{
  "name": "clash-cup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shell": "npm run dev --workspace @clash-cup/shell",
    "dev:portal": "npm run dev --workspace @clash-cup/portal",
    "dev:api": "npm run dev --workspace @clash-cup/api",
    "build": "npm run build --workspaces --if-present",
    "preview": "node scripts/dev.mjs --preview",
    "typecheck": "tsc --noEmit",
    "architecture": "node scripts/check-architecture.mjs && node scripts/shop-rules.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run architecture && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "dev:auth": "npm run dev --workspace @clash-cup/auth",
    "dev:competition": "npm run dev --workspace @clash-cup/competition",
    "dev:player": "npm run dev --workspace @clash-cup/player"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.2",
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "styled-components": "6.5.3",
    "zod": "4.6.5",
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.23.4",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.0.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "@testing-library/user-event": "14.6.1"
  }
}
