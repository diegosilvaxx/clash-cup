{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@clash-cup/contracts": ["./packages/contracts/src/index.ts"],
      "@clash-cup/http": ["./packages/http/src/index.ts"],
      "@clash-cup/ui": ["./packages/ui/src/index.tsx"],
      "@clash-cup/session": ["./packages/session/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tooling", "tests", "*.config.ts"]
}
